# Vertex + ADC is the live runtime. Do not bake a project id or keys.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-3.5-flash

# Official Parallel Web SDK. Empty locally — GET never spends this rail.
# PARALLEL_API_KEY=

# Local file store unless ADC / emulator is present.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

FIRESTORE_COLLECTION=onecrew
ONECREW_PORT=43158

# Unset on a public service: POST that spends Parallel/Imagen returns 403.
# First-open still shows the seeded oc-recession-july-2026 packet (no spend).
# To run a live shift locally: export SHIFT_TOKEN and send header X-Shift-Token.
# SHIFT_TOKEN=
